# ============================================================
# NagatoDownloader - .gitignore
# ============================================================

# ---------- 本项目特有的运行时文件 ----------
# 配置文件（含 RefreshToken，绝对不能提交）
config.toml

# 队列持久化（含未完成任务的下载记录）
queue.json

# 下载历史（含用户行为记录）
history.json

# 日志目录
logs/
*.log

# 打包输出目录
dist/
build/
*.spec.bak

# ExifTool 二进制（体积大，由用户自行下载或从 Release 获取）
# 如希望仓库自带 ExifTool，注释掉以下两行
plugins/ExifTool.exe
plugins/exiftool_files/

# 临时参数文件（ExifTool 调用时可能残留）
args.txt

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# 分发 / 打包
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
# （通常与 build/ dist/ 一起忽略，见上方"打包输出目录"）
*.manifest
*.spec.bak

# 单元测试 / 覆盖率
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# 翻译文件
*.mo
*.pot

# Django（用不到，但保留通用模板）
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask（用不到，但保留通用模板）
instance/
.webassets-cache

# Jupyter Notebook（用不到，但保留通用模板）
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# pipenv
Pipfile.lock

# poetry
poetry.lock

# pdm
.pdm.toml

# 虚拟环境
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Spyder
.spyderproject
.spyproject

# Rope
.ropeproject

# mkdocs
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre
.pyre/

# pytype
.pytype/

# Cython
cython_debug/

# ---------- 编辑器 / IDE ----------
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/

# JetBrains (PyCharm, IntelliJ)
.idea/
*.iml
*.iws
*.ipr
out/

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# ---------- 操作系统 ----------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ---------- 其他 ----------
# 本地测试数据
demo.py
demo.json
test_data/
sandbox/
*.tmp
*.bak
*.orig

# 环境变量
.env
.env.local
.env.*.local
